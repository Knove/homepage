---
import "../styles/global.css";
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, stripBase, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  bodyClass = "",
  noindex = false,
} = Astro.props;

const pagePath = withBase(Astro.url.pathname);
const routePath = stripBase(pagePath);
const isArticle = routePath.startsWith("/writing/");
const canonicalUrl = Astro.site
  ? new URL(pagePath, Astro.site).toString()
  : undefined;
const socialImage = new URL(
  withBase("/images/og-knove.jpg"),
  Astro.site ?? Astro.url.origin,
).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0b09" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Knove — 在噪声里，留一小块黑。封面摄影：Sahil Rathod，CC BY-SA 4.0。"
    />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Knove — Writing"
      href={withBase("/rss.xml")}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <slot />
  </body>
</html>
