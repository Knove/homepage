---
import PixelWordmark from "./PixelWordmark.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["site-header", className]}>
  <a class="site-mark" href="/" aria-label="Knove，返回首页">
    <PixelWordmark />
  </a>

  <nav class="site-nav" aria-label="站点导航">
    <a href="/#writing">Writing</a>
    <a href="/#work">Work</a>
    <a href="/#about">About</a>
    <a class="site-nav-rss" href="/rss.xml">
      RSS <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
